# Tallyform — Supabase configuration
#
# Copy this file to `.env.local` and fill in the values, then restart the dev
# server. Vite only exposes variables prefixed with VITE_ to the browser.
#
# Supabase Dashboard → your project → Project Settings → API:
#   - Project URL          -> VITE_SUPABASE_URL
#   - anon "public" key    -> VITE_SUPABASE_ANON_KEY
#
# Use the anon/public key only. Never put the `service_role` key in a VITE_ var:
# anything prefixed VITE_ ships to every visitor and bypasses Row Level Security.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=